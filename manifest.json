{
	"name": "Clavimit",
	"version": "0.1.0",
	"description": "Encrypt and decrypt Gmail messages locally using AES-256-GCM and RSA-OAEP.",
	"permissions": [
		"activeTab",
		"scripting",
		"sidePanel"
	],
	"manifest_version": 3,
	"action": {
		"default_title": "Open Clavimit",
		"default_popup": "popup.html"
	},
	"side_panel": {
		"default_path": "index.html"
	},
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	}
}